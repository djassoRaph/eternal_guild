; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ShiningSun"
run/main_scene="uid://83x67lyylyw3"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/ui/icons/icon.svg"

[autoload]

GameBus="*res://scripts/buses/GameBus.gd"
AdventurerBus="*res://scripts/buses/AdventurerBus.gd"
EconomyBus="*res://scripts/buses/EconomyBus.gd"
WorldBus="*res://scripts/buses/WorldBus.gd"
GuildBus="*res://scripts/buses/GuildBus.gd"
LegacyBus="*res://scripts/buses/LegacyBus.gd"
GameManager="*res://scripts/GameManager.gd"
DataManager="*res://systems/DataManager.gd"
SaveSystem="*res://systems/SaveSystem.gd"
WorldManager="*res://systems/WorldManager.gd"
ZonePromptUI="*res://scripts/game/ZonePromptUI.gd"
PlayerManager="*res://scripts/autoload/PlayerManager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"
MCPRuntime="*res://addons/godot_mcp_runtime/mcp_runtime_autoload.gd"
McpInteractionServer="*res://mcp_interaction_server.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_placer/plugin.cfg", "res://addons/auto_reload/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_mcp_editor/plugin.cfg", "res://addons/godot_mcp_runtime/plugin.cfg")

