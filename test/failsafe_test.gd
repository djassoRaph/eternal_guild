	for i in 3:
		qd.tick(dt)
	var briefing: bool = brain.state() == "BRIEFING" and qd.work_state() == "BRIEFING"
	board.visible = false
	for i in 3:
		qd.tick(dt)
	check(briefing and brain.state() == "IDLE", "a screen up (a mission_board member): BRIEFING (Brief); hidden: IDLE")
	var body := CharacterBody3D.new()
	var cap := CollisionShape3D.new()
	cap.shape = CapsuleShape3D.new()
	body.add_child(cap)
	body.add_to_group("player")
	world.add_child(body)
	body.global_position = zone.global_position
	for i in 6:
		await physics_frame
	for i in 3:
		qd.tick(dt)
	var avail: bool = brain.state() == "AVAILABLE" and qd.work_state() == "AVAILABLE"
	body.global_position = DESK_WORLD + Vector3(0, 1, 8)
	for i in 6:
		await physics_frame
	for i in 3:
		qd.tick(dt)
	check(avail and brain.state() == "IDLE", "the player at the desk front: AVAILABLE; gone: IDLE")
	# the morning round: day_changed arms it; it waits for the screens, then runs once
	gm.current_day = 21
	gb.day_changed.emit(21)
	board.visible = true
	var t := 0.0
	while t < brain.round_delay + 2.0:
		qd.tick(dt)
		t += dt
	var held: bool = gm.desk_round_day == 20 and gm.active_missions.is_empty()
	board.visible = false
	var seen_brief := false
	t = 0.0
	while t < brain.round_delay + 4.0 and gm.desk_round_day != 21:
		qd.tick(dt)
		t += dt
	seen_brief = brain.state() == "BRIEFING"
	var bubble := ""
	for c in qd.get_children():
		if c is PatronSpeechBubble:
			for l in c.find_children("*", "Label3D", true, false):
				bubble = (l as Label3D).text.replace("\n", " ")   # the bubble wraps its lines
	var waited := t
	t = 0.0
	while t < 5.0 and brain.state() != "IDLE":
		qd.tick(dt)
		t += dt
	check(held and gm.desk_round_day == 21 and gm.active_missions.size() == 1 and seen_brief and bubble.contains("Nina")
		and bubble.contains("Clear Slime Infestation") and brain.state() == "IDLE" and waited >= brain.round_delay - 0.1,
		"day_changed arms the round; a screen up holds it; then after %.1f s she briefs, sends Nina (one contract), says so ('%s'), and goes back to writing" % [waited, bubble])
	# a brain set up on a morning whose round hasn't run runs it without a day_changed
	qd.brain.queue_free()
	qd.brain = null
	await process_frame
	gm.adventurers = [_t36_adv(905, "Kael", "wands_04_four", 10)]
	gm.active_missions = []
	wm.world_map = [_t36_hex("hex_7", T36_SLIME.duplicate(true))]
	gm.current_day = 22
	qd.enable_automation()
	brain = qd.brain
	t = 0.0
	while t < brain.round_delay + 3.0 and gm.desk_round_day != 22:
		qd.tick(dt)
		t += dt
	var armed_at_setup: bool = gm.desk_round_day == 22 and gm.active_missions.size() == 1
	# on strike: no round, her autopilot back on
	gm.staff_record("desk_manager").on_strike = true
	gm.current_day = 23
	gb.day_changed.emit(23)
	for i in int((brain.round_delay + 2.0) / dt):
		qd.tick(dt)
	var strike_ok: bool = gm.desk_round_day == 22 and qd.autopilot and brain.state() == "IDLE"
	gm.staff_record("desk_manager").on_strike = false
	check(armed_at_setup and strike_ok, "a brain set up on a morning whose round hasn't run runs it; on strike no round and the cosmetic autopilot is back")
	# review P12 (AC 4): the strike cancelled that morning's round: paid back the same day, she sends nobody until tomorrow
	var back := _t35_tick(qd, 10.0, func(): return qd.can_drive() and not qd.autopilot)
	_t35_tick(qd, brain.round_delay + 2.0, func(): return gm.desk_round_day != 22)
	check(gm.desk_round_day == 22 and gm.active_missions.size() == 1 and not qd.autopilot,
		"a strike cancels the armed round: back at work the same morning (after %.1f s), no round that day (review P12)" % back)
	var pos0: Vector3 = qd.global_position
	var st0: String = brain.state()
	qd.tick(0.0)
	check(qd.global_position == pos0 and brain.state() == st0, "tick(0.0) changes nothing")
	await _check_t36_holds(gm, wm, gb, qd, world)
	world.queue_free()
	await process_frame


## Review P6: what holds her round: the morning reports (13.4's morning_briefing group: BRIEFING while they show), a
## paused game, a game over; a dismissal (staff_fired) means no round at all.
func _check_t36_holds(gm, wm, gb, qd, world: Node3D) -> void:
	var brain = qd.brain
	var reports := Control.new()
	reports.add_to_group("morning_briefing")
	world.add_child(reports)
	gm.adventurers = [_t36_adv(906, "Sela", "wands_05_five", 10)]
	gm.active_missions = []
	wm.world_map = [_t36_hex("hex_8", T36_SLIME.duplicate(true))]
	gm.current_day = 24
	gb.day_changed.emit(24)
	_t35_tick(qd, brain.round_delay + 2.0, func(): return false)
	var held: bool = gm.desk_round_day == 22 and brain.state() == "BRIEFING" and qd.work_state() == "BRIEFING"
	reports.visible = false
	var t := _t35_tick(qd, brain.round_delay + 4.0, func(): return gm.desk_round_day == 24)
	check(held and gm.desk_round_day == 24 and gm.active_missions.size() == 1 and t >= brain.round_delay - 0.1,
		"the morning reports up: she BRIEFS and the armed round waits; closed: it runs %.1f s later (review P6)" % t)
	reports.queue_free()
	# paused, then a game over: the armed round waits; neither cancels it
	gm.active_missions = []
	gm.current_day = 25
	gb.day_changed.emit(25)
	var tree: SceneTree = qd.get_tree()
	tree.paused = true
	_t35_tick(qd, brain.round_delay + 2.0, func(): return false)
	var paused_held: bool = gm.desk_round_day == 24
	tree.paused = false
	gm.game_over_active = true
	_t35_tick(qd, brain.round_delay + 2.0, func(): return false)
	var over_held: bool = gm.desk_round_day == 24
	gm.game_over_active = false
	_t35_tick(qd, brain.round_delay + 2.0, func(): return gm.desk_round_day == 25)
	check(paused_held and over_held and gm.desk_round_day == 25, "paused or a game over: the armed round waits (%s, %s); then it runs (review P6)" % [paused_held, over_held])
	# dismissed (GuildBus.staff_fired): no round, her autopilot back
	gm.current_day = 26
	gb.day_changed.emit(26)
	var why: String = gm.dismiss_staff("desk_manager")
	_t35_tick(qd, brain.round_delay + 2.0, func(): return false)
	check(why == "" and gm.desk_round_day == 25 and qd.autopilot and brain.state() == "IDLE",
		"dismissed (staff_fired) on an armed morning: no round, the cosmetic autopilot back (review P6)")
	await process_frame


## Story 14.6: the shipped build is the demo (profiles.demo: 40 gold, a 20-gold tax every 3 days, faster tiers, no staff at
## start). A test that checks a mechanism with the full game's numbers pins the full profile, then restores it.
func _pin_profile(dm, profile: String):
	if dm == null:
		return null
	var keep = [dm.game_config.get("profile"), dm.get("run_profile")]
	dm.game_config["profile"] = profile
	dm.set("run_profile", "")   # review P5: a run's profile (set by a load) would win over the pin
	return keep


func _unpin_profile(dm, keep) -> void:
	if dm == null or not (keep is Array):
		return
	if keep[0] == null:
		dm.game_config.erase("profile")
	else:
		dm.game_config["profile"] = keep[0]
	if keep[1] != null:
		dm.set("run_profile", keep[1])


