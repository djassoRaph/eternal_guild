			if absf(Vector2(d.x, d.z).length() - bs.ring_radius_at(atan2(d.x, d.z))) > 0.01 or absf(arc[i].y - RING_CENTER.y) > 0.001:
				why.append("off the ring at %.0f°" % phi_deg)
