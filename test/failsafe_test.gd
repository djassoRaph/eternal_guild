	_check_t31_source()
	_check_t31_banners(eb, nm)
	await _check_t31_debug_panel(gm, events)

	for s in recs:
		if eb.is_connected(s, recs[s]):
			eb.disconnect(s, recs[s])
	gm.set("_tax_warnings", warned_before)
	ss.save_path = ss_saved[0]
	ss.codex_path = ss_saved[1]
