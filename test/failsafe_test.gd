	q_arrived[0] = false
	gb.staff_hired.emit("t_desk", "desk_manager")
	var seq_b := []
	var ahead_b := false
	n = 0
	while n < 3000 and not q_arrived[0]:
		qd.tick(dt)
		n += 1
		var sb: String = qd.anim_state()
		if seq_b.is_empty() or seq_b[seq_b.size() - 1] != sb:
