	q_arrived[0] = false
	gb.staff_hired.emit("t_desk", "desk_manager")
	for i in 60:
		qd.tick(dt)
	var walking_in: bool = qd._route_phase == "in" and qd.is_walking()
	qd.set_work_state("BRIEFING")
	n = 0
	while n < 3000 and not q_arrived[0]:
