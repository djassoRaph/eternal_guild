func test_round_bar() -> void:
	print("[Test 12] The Round Bar and drinks service")
	for spec in [[ROUND_BAR_PATH, 6000, 1], [BAR_STOOL_PATH, 150, 0], [BACK_BAR_PATH, 3000, 0],
			[TANKARD_FULL_PATH, 300, 0], [TANKARD_EMPTY_PATH, 300, 0]]:
