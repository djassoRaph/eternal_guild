## Ticks a staff node by 1/30 s until `done` is true or `cap` seconds pass; `each` runs after every tick. The seconds ticked.
func _t35_tick(bt, cap: float, done: Callable, each := Callable()) -> float:
	var t := 0.0
	var dt := 1.0 / 30.0
	while t < cap - 0.0001:
		bt.tick(dt)
		t += dt
		if each.is_valid():
			each.call()
		if done.call():
			break
	return t


