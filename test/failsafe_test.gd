func _check_t34_rows(gm, sp) -> void:
	var recs: Array = gm.staff_seed(T33_ROLES, "demo", ["bartender", "desk_manager"], T33_WAGES)
	var demo := {"profile": "demo", "start_staff": ["bartender", "desk_manager"], "tier_index": 0, "tiers": T33_TIERS, "gold": 100}
	var full := {"profile": "full", "start_staff": [], "tier_index": 0, "tiers": T33_TIERS, "gold": 100}
	var rows: Array = sp.staff_rows(recs, T33_ROLES, demo)
	check(rows.size() == 2 and rows.all(func(v): return v.state == "working" and v.line == "Working" and _t34_acts(v) == ["dismiss:Dismiss:true"])
		and rows[0].name == "The Bartender" and rows[0].wage == 3 and rows[1].name == "The Quest Dealer" and rows[1].wage == 4,
		"staff_rows, the demo: both Working, each with Dismiss %s" % [rows])
	recs[1].on_strike = true
	recs[1].owed = 4
	rows = sp.staff_rows(recs, T33_ROLES, demo.merged({"gold": 3}, true))
	var s1: Dictionary = rows[1]
	var rows2: Array = sp.staff_rows(recs, T33_ROLES, demo.merged({"gold": 4}, true))
	check(s1.state == "on_strike" and s1.line == "On strike, owed 4 gold" and _t34_acts(s1) == ["pay:Pay 4 gold:false", "dismiss:Dismiss:true"]
		and s1.actions[0].reason == "Not enough gold" and _t34_acts(rows2[1]) == ["pay:Pay 4 gold:true", "dismiss:Dismiss:true"],
		"a striker: On strike, owed 4 gold; Pay 4 gold (disabled with the reason when short) and Dismiss %s" % [_t34_acts(s1)])
	var free_recs: Array = gm.staff_seed(T33_ROLES, "full", [], T33_WAGES)
	var locked: Array = sp.staff_rows(free_recs, T33_ROLES, full)
	var at_trusted: Array = sp.staff_rows(free_recs, T33_ROLES, full.merged({"tier_index": 2}, true))
	var poor: Array = sp.staff_rows(free_recs, T33_ROLES, full.merged({"tier_index": 3, "gold": 2}, true))
	check(locked.all(func(v): return v.state == "locked" and v.actions.is_empty()) and locked[0].line == "Joins at Trusted"
		and locked[1].line == "Joins at Respected"
		and at_trusted[0].state == "candidate" and at_trusted[0].line == "Not hired" and _t34_acts(at_trusted[0]) == ["hire:Hire (3 gold):true"]
		and at_trusted[1].state == "locked"
		and poor.all(func(v): return v.state == "candidate" and v.actions.size() == 1 and v.actions[0].enabled == false and v.actions[0].reason == "Not enough gold")
		and _t34_acts(poor[0]) == ["hire:Hire (3 gold):false"],
		"the full profile: locked rows say the tier (no button); a candidate shows Hire (3 gold), disabled with \"Not enough gold\" when short %s %s" % [_t34_acts(at_trusted[0]), _t34_acts(poor[0])])
	var with_unknown: Array = recs.duplicate(true) + [{"role": "garden_manager", "staff_id": "garden_manager/x", "name": "x", "daily_wage": 1, "hired": true}]
	check(sp.staff_rows(with_unknown, T33_ROLES, demo).size() == 2, "a record for a role staff.json doesn't name is not shown")
	# Review P2 (K-7, 150 gold): the demo's gold-peak lock is a locked row; P3 (K-12): a role that left owing shows the debt
	var gp := {"profile": "demo", "start_staff": [], "tier_index": 4, "tiers": T33_TIERS, "gold": 100, "gold_peak": 100,
		"unlock": {"rule": "gold_peak", "gold_peak": 150}}
	var gp_rows: Array = sp.staff_rows(free_recs, T33_ROLES, gp)
	var gp_open: Array = sp.staff_rows(free_recs, T33_ROLES, gp.merged({"gold_peak": 150}, true))
	var owing: Array = free_recs.duplicate(true)
	owing[1].owed = 4
	var o_rows: Array = sp.staff_rows(owing, T33_ROLES, gp.merged({"gold_peak": 150, "gold": 7}, true))
	var o_rich: Array = sp.staff_rows(owing, T33_ROLES, gp.merged({"gold_peak": 150, "gold": 8}, true))
	check(gp_rows.all(func(v): return v.state == "locked" and v.line == "Joins at 150 gold" and v.actions.is_empty())
		and _t34_acts(gp_open[0]) == ["hire:Hire (3 gold):true"] and o_rows[1].line == "Not hired, owed 4 gold"
		and _t34_acts(o_rows[1]) == ["hire:Hire (8 gold):false"] and _t34_acts(o_rich[1]) == ["hire:Hire (8 gold):true"],
		"the demo's lock: 'Joins at 150 gold' (no button) until the gold peak reaches it; a role that left owing 4: 'Not hired, owed 4 gold', Hire (8 gold) %s %s" % [gp_rows.map(func(v): return v.line), _t34_acts(o_rows[1])])


## A view's actions as "id:text:enabled" strings.
static func _t34_acts(v: Dictionary) -> Array:
	var out := []
	for a in v.get("actions", []):
		out.append("%s:%s:%s" % [a.id, a.text, a.enabled])
	return out


## AC 2–5 (16.2): the section live: Pay, Dismiss with its confirm, Hire, through GameManager.
func _check_t34_live(gm, gb, sp) -> void:
	var events: Array = []
	var recs := {
		"staff_hired": func(id, r): events.append(["hired", id]),
		"staff_fired": func(id, r): events.append(["fired", id]),
		"staff_strike_changed": func(id, on): events.append(["strike", id, on]),
	}
	for s in recs:
		gb.connect(s, recs[s])
	var capture := _t28_capture()
	var scene_before := current_scene
	_d1_set_scene(capture)
	gm.staff = gm.staff_seed(gm.staff_roles(), "demo", ["bartender", "desk_manager"], {"daily_wage": {"bartender": 3, "desk_manager": 4}})
	var d: Dictionary = gm.staff_record("desk_manager")
	d.on_strike = true
	d.owed = 4
	gm.gold = 10
	var sec = sp.new()
	root.add_child(sec)
	var acted: Array = []
	sec.acted.connect(func(role, action, why): acted.append([role, action, why]))
	sec.refresh()
	var state_d: String = _t34_text(sec, "desk_manager_state")
	var pay = sec.find_child("desk_manager_pay", true, false)
	check(_t34_text(sec, "bartender_state") == "Working" and state_d == "On strike, owed 4 gold" and pay is Button and (pay as Button).text == "Pay 4 gold"
		and not (pay as Button).disabled and sec.find_child("bartender_dismiss", true, false) is Button,
		"the section: one row per role, the state line, Pay 4 gold on the striker, Dismiss on each ('%s')" % state_d)
	(pay as Button).pressed.emit()
	await process_frame
	check(d.on_strike == false and gm.gold == 6 and events == [["strike", "desk_manager/silver_elf", false]] and acted == [["desk_manager", "pay", ""]]
		and _t34_text(sec, "desk_manager_state") == "Working",
		"Pay: the back wage paid through GameManager, the row back to Working %s" % [events])
	events.clear()
	var dis = sec.find_child("bartender_dismiss", true, false)
	(dis as Button).pressed.emit()
	await process_frame
	var armed = sec.find_child("bartender_dismiss", true, false)
	var armed_ok: bool = armed is Button and (armed as Button).text == "Sure? Dismiss" and gm.is_staff_hired("bartender") and events.is_empty()
	(armed as Button).pressed.emit()          # review P9: a double-click's second press, right after the first, is ignored
	await process_frame
	var still_armed = sec.find_child("bartender_dismiss", true, false)
	var double_ok: bool = still_armed is Button and (still_armed as Button).text == "Sure? Dismiss" and gm.is_staff_hired("bartender") and events.is_empty()
	await create_timer(0.45).timeout
	(sec.find_child("bartender_dismiss", true, false) as Button).pressed.emit()
	await process_frame
	var hire = sec.find_child("bartender_hire", true, false)
	check(armed_ok and double_ok and gm.is_staff_hired("bartender") == false and events == [["fired", "bartender/barkeep"]]
		and _t34_text(sec, "bartender_state") == "Not hired" and hire is Button and (hire as Button).text == "Hire (3 gold)",
		"Dismiss asks first (Sure? Dismiss, nothing changes; a double-click's second press within 0.4 s is ignored), then dismisses: one staff_fired, the row a candidate %s" % [events])
	gm.gold = 2
	sec.refresh()
	hire = sec.find_child("bartender_hire", true, false)
	var poor_ok: bool = hire is Button and (hire as Button).disabled and (hire as Button).text == "Hire (3 gold)" \
		and _t34_text(sec, "bartender_reason") == "Not enough gold"
	gm.gold = 10
	sec.refresh()
	events.clear()
	(sec.find_child("bartender_hire", true, false) as Button).pressed.emit()
	await process_frame
	check(poor_ok and gm.is_staff_hired("bartender") and gm.gold == 7 and events == [["hired", "bartender/barkeep"]]
		and _t34_text(sec, "bartender_state") == "Working",
		"Hire: disabled with \"Not enough gold\" when short; with the gold, hired through GameManager (one staff_hired), back to Working %s" % [events])
	sec.queue_free()
	for s in recs:
		if gb.is_connected(s, recs[s]):
			gb.disconnect(s, recs[s])
	_d1_set_scene(scene_before)
	capture.free()
	await process_frame


## A Label's text found by name under `n` ("" when missing).
static func _t34_text(n: Node, label_name: String) -> String:
	var l = n.find_child(label_name, true, false)
	return (l as Label).text if l is Label else ""


# --- Test 35: The Bartender serves (Story 16.3) ---
# His FSM is a LimboAI LimboHSM built in code (IDLE, SERVING, RESTOCKING; update mode MANUAL, updated from his own
# tick() so tests step it), switched on by the hall (enable_automation). He takes the longest-waiting patron on a stool
# that faces one of his serve stations, hands the drink over through the patron's own serve_patron() (consume_drink
# beer: the player's path), restocks at the kegs while the beer is out and retries the same patron, takes no orders on
# strike, and never leaves the ring (the tables stay the player's). All LimboAI code lives in scripts/game/staff_ai.gd.
const STAFF_AI_SCRIPT := "res://scripts/game/staff_ai.gd"
const BARTENDER_AI_SCRIPT := "res://scripts/game/bartender_ai.gd"


func test_bartender_serves() -> void:
	print("[Test 35] The Bartender serves (Story 16.3)")
	var t35_ms := Time.get_ticks_msec()
	var limbo_ok := _check_t35_limbo()
	var gm = root.get_node_or_null("GameManager")
	var wm = root.get_node_or_null("WorldManager")
	var dm = root.get_node_or_null("DataManager")
	var gb = root.get_node_or_null("GuildBus")
	var eb = root.get_node_or_null("EconomyBus")
	_check_t35_source()
	if not limbo_ok or gm == null or not ResourceLoader.exists(BARTENDER_AI_SCRIPT) or not ResourceLoader.exists(STAFF_AI_SCRIPT) \
			or not gm.has_method("is_staff_working"):
		check(false, "the Bartender's brain (staff_ai.gd, bartender_ai.gd) and GameManager's staff records (LimboAI ok: %s)" % limbo_ok)
		return
	var snap := _t28_snapshot(gm, wm, dm)
	var capture := _t28_capture()
	_d1_set_scene(capture)
	check(get_nodes_in_group("patrons").is_empty(), "precondition: no patrons in the tree before Test 35's small world")
	dm.game_config["demo_start_staff"] = ["bartender", "desk_manager"]   # Story 14.6 (K-7): a fixture seed; restored with the snapshot
	gm.staff = gm._seeded_staff()
	gm.beer_stock = 5
	eb.beer_changed.emit(5)
	var world := Node3D.new()
	root.add_child(world)
	var door := _make_door()
	world.add_child(door)
	door.global_position = DOOR_CENTER
	var bar = (load(ROUND_BAR_SCENE_PATH) as PackedScene).instantiate()
	world.add_child(bar)
	bar.global_position = RING_CENTER
	var patron_script = load(PATRON_SCRIPT_PATH)
	var seat08: Vector3 = patron_script.seat_root((bar.get_node("Stools/Stool08").find_child("SeatPoint", true, false) as Node3D).global_transform)
	var seat10: Vector3 = patron_script.seat_root((bar.get_node("Stools/Stool10").find_child("SeatPoint", true, false) as Node3D).global_transform)
	var route := PackedVector3Array()
	var tav := _scene_nodes(TAVERN_SCENE_PATH)
	for k in tav:
		if tav[k].instance == BARTENDER_SCENE:
			route = tav[k].props.get("arrive_route", PackedVector3Array())
	var bt = (load(BARTENDER_SCENE) as PackedScene).instantiate()
	bt.manual_tick = true
	bt.hired_at_start_override = 1
	bt.bar_path = bar.get_path()
	bt.door_path = door.get_path()
	bt.arrive_route = route
	world.add_child(bt)
	bt.tick(1.0 / 30.0)
	var fix := GDScript.new()
	fix.source_code = T35_PATRON_SRC
	fix.reload()
	var p08 = _t35_patron(world, fix, seat08)
	var p10 = _t35_patron(world, fix, seat10)
	var table = _t35_patron(world, fix, RING_CENTER + Vector3(-6.5, 0.0, 6.0))   # a table spot, far from every stool
	p08.waiting = false
	p10.waiting = false
	check(bt.station_for_patron(seat08) == 0 and bt.station_for_patron(seat10) >= 0 and bt.station_for_patron(table.global_position) == -1,
		"station_for_patron: stool 08 faces serve_point_01, stool 10 one of his stations, a table spot none (%d, %d, %d)"
		% [bt.station_for_patron(seat08), bt.station_for_patron(seat10), bt.station_for_patron(table.global_position)])

	# M. 25.13's Bartender without automation: a waiting stool patron is never served
	p08.waiting = true
	_t35_tick(bt, 15.0, func(): return false)
	check(p08.served == 0 and gm.beer_stock == 5 and bt.brain == null, "without enable_automation() he stays 25.13's cosmetic Bartender: a waiting stool patron is never served")
	p08.waiting = false

	bt.enable_automation()
	bt.enable_automation()   # once only
	_check_t35_structure(bt)
	var brain = bt.brain
	# B. the react time, the serve, one consume, back to IDLE; work_state follows the FSM
	_t35_tick(bt, 3.0, func(): return false)
	p08.waiting = true
	var anims := []
	var mismatch := []
	var track := func():
		var a: String = bt.anim_state()
		if anims.is_empty() or anims[anims.size() - 1] != a:
			anims.append(a)
		if bt.work_state() != brain.state():
			mismatch.append([brain.state(), bt.work_state()])
	var waited := _t35_tick(bt, 10.0, func(): return brain.state() == "SERVING", track)
	var took := _t35_tick(bt, 60.0, func(): return brain.state() == "IDLE", track)
	check(waited >= brain.react_seconds - 0.05 and waited <= brain.react_seconds + 0.1 and p08.served == 1 and gm.beer_stock == 4
		and _t35_subseq(anims, ["Pour", "Serve"]) and mismatch.is_empty() and table.served == 0,
		"a stool patron waits %.1f s (react %.1f), then SERVING: Pour, then Serve, ONE consume at the release (beer 5 -> %d), back to IDLE after %.1f s; work_state() matched the FSM; the table patron untouched %s %s"
		% [waited, brain.react_seconds, gm.beer_stock, took, anims, mismatch])
	# D. two waiting: the longer first
	p10.waiting = true
	_t35_tick(bt, 1.0, func(): return false)
	p08.waiting = true
	p08.served = 0
	p10.served = 0
	var order := []
	var note := func():
		if p10.served == 1 and not order.has("p10"):
			order.append("p10")
		if p08.served == 1 and not order.has("p08"):
			order.append("p08")
	_t35_tick(bt, 90.0, func(): return p08.served == 1 and p10.served == 1, note)
	check(order == ["p10", "p08"] and gm.beer_stock == 2 and table.served == 0, "two stool patrons waiting: the one waiting longer is served first %s" % [order])
	# E. beer 0: RESTOCKING at the kegs, nothing handed over; beer back: served
	_t35_tick(bt, 3.0, func(): return brain.state() == "IDLE")
	_t35_set_beer(gm, eb, 0)
	p08.waiting = true
	p08.served = 0
	var rest_t := _t35_tick(bt, 30.0, func(): return brain.state() == "RESTOCKING" and bt._station == bt.RESTOCK_INDEX)
	_t35_tick(bt, 10.0, func(): return false)
	var dry_ok: bool = brain.state() == "RESTOCKING" and bt.anim_state() == "Restock" and p08.served == 0 and gm.beer_stock == 0
	gm.add_beer(1)
	_t35_tick(bt, 40.0, func(): return p08.served == 1)
	check(dry_ok and p08.served == 1 and gm.beer_stock == 0,
		"beer 0: RESTOCKING at the kegs (%.1f s), nothing handed over; beer back: the waiting patron is served (beer %d)" % [rest_t, gm.beer_stock])
	# F. the same tick: a patron starts waiting and the beer runs out
	_t35_tick(bt, 5.0, func(): return brain.state() == "RESTOCKING")
	gm.add_beer(3)
	_t35_tick(bt, 30.0, func(): return brain.state() == "IDLE")
	p08.waiting = true
	p08.served = 0
	_t35_set_beer(gm, eb, 0)
	_t35_tick(bt, 6.0, func(): return false)
	check(brain.state() == "RESTOCKING" and p08.served == 0, "a patron starts waiting as the beer runs out (one tick): RESTOCKING, no serve attempt")
	gm.add_beer(3)
	_t35_tick(bt, 40.0, func(): return p08.served == 1)
	_t35_tick(bt, 30.0, func(): return brain.state() == "IDLE")
	# G. served by the player while he walks
	p10.waiting = true
	p10.served = 0
	_t35_tick(bt, 10.0, func(): return brain.state() == "SERVING")
	_t35_tick(bt, 1.0, func(): return false)
	var beer_g: int = gm.beer_stock
	p10.waiting = false        # the player's E got there first
	_t35_tick(bt, 1.0 / 30.0 * 2, func(): return false)
	check(brain.state() == "IDLE" and gm.beer_stock == beer_g and p10.served == 0 and bt.work_state() == "IDLE" and bt._tankard == null,
		"served by someone else while he walks: IDLE at once, nothing consumed, the serve dropped (no tankard; back to wiping) (%s, %s)" % [brain.state(), bt.work_state()])
	# H. the beer runs out between the pour and the release
	_t35_tick(bt, 3.0, func(): return false)
	p10.waiting = true
	_t35_tick(bt, 10.0, func(): return bt.anim_state() == "Pour")
	_t35_set_beer(gm, eb, 0)
	_t35_tick(bt, 40.0, func(): return brain.state() == "RESTOCKING")
	var h_ok: bool = brain.state() == "RESTOCKING" and p10.served == 0 and brain.target == p10
	gm.add_beer(1)
	_t35_tick(bt, 40.0, func(): return p10.served == 1)
	check(h_ok and p10.served == 1 and gm.beer_stock == 0,
		"the beer runs out between the pour and the release: RESTOCKING, nothing handed over; beer back: he retries the same patron")
	gm.add_beer(5)
	_t35_tick(bt, 30.0, func(): return brain.state() == "IDLE")
	# I. on strike: no orders; the strike over: served
	var rec: Dictionary = gm.staff_record("bartender")
	rec.on_strike = true
	p08.waiting = true
	p08.served = 0
	_t35_tick(bt, 20.0, func(): return false)
	var strike_ok: bool = p08.served == 0 and brain.state() == "IDLE"
	rec.on_strike = false
	_t35_tick(bt, 40.0, func(): return p08.served == 1)
	check(strike_ok and p08.served == 1, "on strike: IDLE, a waiting stool patron left for the player for 20 s; the strike over: served")
	_t35_tick(bt, 30.0, func(): return brain.state() == "IDLE")
	# K. game over: no orders
	gm.game_over_active = true
	p08.waiting = true
	p08.served = 0
	_t35_tick(bt, 8.0, func(): return false)
	var go_ok: bool = p08.served == 0 and brain.state() == "IDLE"
	gm.game_over_active = false
	p08.waiting = false
	check(go_ok, "Game Over: no orders")
	# Review P7: paused: no orders (the hall runs while paused; the brain checks)
	var tree := bt.get_tree()
	tree.paused = true
	p08.waiting = true
	p08.served = 0
	_t35_tick(bt, 8.0, func(): return false)
	var paused_ok: bool = p08.served == 0 and brain.state() == "IDLE"
	tree.paused = false
	_t35_tick(bt, 40.0, func(): return p08.served == 1)
	check(paused_ok and p08.served == 1, "paused: a waiting stool patron gets no order; unpaused: served (review P7)")
	_t35_tick(bt, 30.0, func(): return brain.state() == "IDLE")
	# Review P7: a strike while SERVING drops the serve, nothing consumed
	p10.waiting = true
	p10.served = 0
	_t35_tick(bt, 10.0, func(): return brain.state() == "SERVING")
	_t35_tick(bt, 1.0, func(): return false)
	var beer_s: int = gm.beer_stock
	rec.on_strike = true
	_t35_tick(bt, 2.0 / 30.0, func(): return false)
	var strike_serving_ok: bool = brain.state() == "IDLE" and gm.beer_stock == beer_s and p10.served == 0 and bt._tankard == null
	_t35_tick(bt, 15.0, func(): return false)
	strike_serving_ok = strike_serving_ok and p10.served == 0 and gm.beer_stock == beer_s
	rec.on_strike = false
	p10.waiting = false
	check(strike_serving_ok, "a strike while SERVING: IDLE at once, the serve dropped, nothing consumed (review P7)")
	_t35_tick(bt, 30.0, func(): return brain.state() == "IDLE")
	# Review P7: the patron gone (freed) while he walks: IDLE, nothing consumed
	var gone = _t35_patron(world, fix, seat08)
	gone.waiting = true
	p08.waiting = false
	_t35_tick(bt, 10.0, func(): return brain.state() == "SERVING")
	_t35_tick(bt, 1.0, func(): return false)
	var beer_f: int = gm.beer_stock
	world.remove_child(gone)
	gone.free()
	_t35_tick(bt, 2.0 / 30.0, func(): return false)
	check(brain.state() == "IDLE" and gm.beer_stock == beer_f and bt._tankard == null, "the patron gone mid-walk (freed): IDLE, nothing consumed (review P7)")
	_t35_tick(bt, 30.0, func(): return brain.state() == "IDLE")
	# L. tick(0) changes nothing
	var pos0: Vector3 = bt.global_position
	var st0: String = brain.state()
	bt.tick(0.0)
	check(bt.global_position == pos0 and brain.state() == st0, "tick(0.0) changes nothing")
	# J. fired mid-serve: nothing consumed, he walks out; hired again: he walks in and serves
	var left := [false]
	var arrived := [false]
	bt.left_tavern.connect(func(): left[0] = true)
	bt.arrived_at_station.connect(func(): arrived[0] = true)
	_t35_tick(bt, 3.0, func(): return false)
	p10.waiting = true
	p10.served = 0
	_t35_tick(bt, 10.0, func(): return brain.state() == "SERVING")
	_t35_tick(bt, 2.0, func(): return false)
	var beer_j: int = gm.beer_stock
	gb.staff_fired.emit("t35", "bartender")
	_t35_tick(bt, 120.0, func(): return left[0])
	var fired_ok: bool = left[0] and not bt.present and brain.state() == "IDLE" and gm.beer_stock == beer_j and p10.served == 0
	gb.staff_hired.emit("t35", "bartender")
	_t35_tick(bt, 150.0, func(): return arrived[0])
